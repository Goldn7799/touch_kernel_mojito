mkdir /var/tmp/build

sudo apt-get update
sudo apt update && sudo apt install -y \
  bc bison flex ccache clang lld llvm make zip curl git cpio xz-utils \
  build-essential libssl-dev libncurses-dev libelf-dev g++ \
  gcc-aarch64-linux-gnu gcc-arm-linux-gnueabi libc6-dev-i386 \
  python-is-python3

sudo apt-get install -y binutils-arm-linux-gnueabi gcc-arm-linux-gnueabi

git clone --depth=1 https://github.com/kdrag0n/proton-clang.git /var/tmp/proton-clang
rm -rf /var/tmp/proton-clang/.git

mv /var/tmp/build/proton-clang/bin/as /var/tmp/build/proton-clang/bin/as.bak
ln -s "$(which arm-linux-gnueabi-as)" /var/tmp/build/proton-clang/bin/as

export PATH="/var/tmp/proton-clang/bin:$PATH"

export ARCH=arm64
export SUBARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-
export CROSS_COMPILE_ARM32=arm-linux-gnueabi-
export CC=clang

 make clean && make mrproper
 make O=/var/tmp/build/out ARCH=arm64 CC=clang CLANG_TRIPLE=aarch64-linux-gnu- \
  HOSTCC="gcc -B/usr/bin" HOSTCXX="g++ -B/usr/bin" vendor/mojito_defconfig